{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve UI (simulated)",
      "type": "shell",
      "command": "python -m http.server 3000",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      },
      "group": "build"
    },
    {
      "label": "Dashboard dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/dashboard"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      },
      "group": "build"
    },
    {
      "label": "Install dashboard deps",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/dashboard"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
